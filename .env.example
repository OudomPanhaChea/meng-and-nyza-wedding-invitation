# Telegram bot — used by the "Leave a Blessing" form to deliver
# guest messages straight to a Telegram chat/group.
#
# 1. Talk to @BotFather on Telegram → /newbot → copy the token.
# 2. Add the bot to the target chat/group, then read the chat_id
#    from https://api.telegram.org/bot<TOKEN>/getUpdates after
#    sending a test message.
#
# Variables are prefixed with VITE_ so Vite exposes them to the
# client bundle. They WILL be visible to anyone who opens the site.
# Do NOT put server-only secrets here.

VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
VITE_TELEGRAM_CHAT_ID=your-telegram-chat-id-here
